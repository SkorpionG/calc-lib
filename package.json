{
  "name": "@skorpiong2000/calc-lib",
  "version": "1.0.0",
  "description": "A TypeScript/JavaScript package that provides a comprehensive toolkit for common STEM applications - precise math, engineering, computer science, and scientific computing",
  "license": "MIT",
  "author": "SkorpionG",
  "homepage": "https://github.com/SkorpionG/calc-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkorpionG/calc-lib.git"
  },
  "bugs": {
    "url": "https://github.com/SkorpionG/calc-lib/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run test && npm run typecheck && npm run lint && npm run format && npm run build"
  },
  "keywords": [
    "math",
    "science",
    "precision",
    "significant-figures",
    "calculations",
    "typescript",
    "stem",
    "engineering",
    "computer science",
    "scientific computing",
    "toolkit",
    "precise"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
